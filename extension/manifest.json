{
  "manifest_version": 3,
  "name": "Vocab English Lens",
  "short_name": "Vocab English Lens",
  "version": "1.2.0",
  "description": "Bôi đen một từ tiếng Anh để xem nghĩa tiếng Việt, phiên âm US/UK, nghe phát âm, lưu từ và ôn bằng flashcard.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Vocab English Lens – Mở sổ từ vựng",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "review.html",
  "permissions": [
    "storage",
    "offscreen",
    "tts",
    "alarms"
  ],
  "host_permissions": [
    "https://clients5.google.com/*",
    "https://translate.googleapis.com/*",
    "https://api.dictionaryapi.dev/*",
    "https://en.wiktionary.org/*",
    "https://*.supabase.co/*",
    "https://api.cognitive.microsofttranslator.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
